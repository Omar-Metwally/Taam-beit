{
  "ConnectionStrings": {
    "Database": "Host=localhost;Port=5432;Database=taambeit;Username=postgres;Password=your_dev_password_here;Include Error Detail=true"
  },
  "Jwt": {
    "SecretKey": "your_dev_jwt_secret_key_at_least_32_chars_long",
    "Issuer": "TaAmBeit.Api",
    "Audience": "TaAmBeit.Client",
    "ExpiryMinutes": 60,
    "CookieName": "taambeit_auth"
  },
  "Cors": {
    "AllowedOrigins": "http://localhost:3000"
  },
  "Quartz": {
    "quartz.scheduler.instanceName": "TaAmBeitScheduler"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Garage": {
    "Endpoint": "http://localhost:3900",
    "AccessKey": "RUN_BOOTSTRAP_TO_GENERATE",
    "SecretKey": "RUN_BOOTSTRAP_TO_GENERATE",
    "PublicBaseUrl": "http://localhost:3903",
    "UseSSL": false
  }
}
